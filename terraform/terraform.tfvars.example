# Copy to terraform.tfvars and fill in values. terraform.tfvars is gitignored;
# this example file has no real secrets and is safe to commit.

# AWS
aws_region  = "ap-south-1"
project     = "inventoryms"
environment = "prod"

# Networking
vpc_cidr             = "10.0.0.0/16"
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.10.0/24", "10.0.11.0/24"]

# Database
db_username       = "inventoryadmin"
db_password       = ""            # no @ / " or spaces
db_instance_class = "db.t3.small" # shared instance for all 4 schemas

# JWT secrets — three required, each min 32 chars (JJWT HS256):
#   [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
jwt_session_secret = ""   # OTP session tokens (auth-service only)
jwt_access_secret  = ""   # API access tokens (all services validate)
jwt_refresh_secret = ""   # refresh tokens (auth-service only)

# Email
mail_username    = ""   # Gmail address used as SMTP sender
mail_password    = ""   # Gmail App Password (myaccount.google.com/apppasswords)
alert_recipients = ""   # comma-separated emails for stock alert notifications

# S3 bucket names (must be globally unique across all of AWS)
image_bucket_name  = "inventoryms-product-images-prod"
report_bucket_name = "inventoryms-reports-prod"

# EC2 / ECS Auto Scaling
# t3.large = 2 usable task slots/instance. Steady-state task count = 11.
# Do not set ec2_desired_instances below 6 — services will fail to place.
ec2_instance_type     = "t3.large"
ec2_min_instances     = 1
ec2_max_instances     = 10
ec2_desired_instances = 6

# CloudWatch alarm notifications
alarm_email = ""   # confirm the SNS subscription email AWS sends you
